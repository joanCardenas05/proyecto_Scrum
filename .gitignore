# Entornos virtuales
.venv/
venv/
env/
ENV/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Cachés y archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Distribuciones y paquetes
build/
dist/
*.egg-info/
.eggs/

# Configuración local de herramientas
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Logs y archivos temporales
*.log
*.tmp
